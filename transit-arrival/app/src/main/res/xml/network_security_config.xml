<?xml version="1.0" encoding="utf-8"?>
<!-- 평문(HTTP) 통신 전면 금지. 시스템 인증서만 신뢰하고, 사용자가 설치한 인증서(가로채기 프록시 등)는 신뢰하지 않는다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
